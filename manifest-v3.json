{
    "manifest_version": 3,
    "name": "__MSG_extension_name__",
    "short_name": "SimpTab",
    "version": "1.5.5",
    "default_locale": "zh_CN",
    "description": "__MSG_extension_desc__",
    "author": "Kenshin",
    "homepage_url": "http://ksria.com/simptab",
    
    "chrome_url_overrides": {
        "newtab": "main.html"
    },
    
    "icons": {
        "16": "assets/images/icon16.png",
        "48": "assets/images/icon48.png",
        "128": "assets/images/icon128.png"
    },
    
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'"
    },
    
    "permissions": [
        "topSites",
        "storage",
        "bookmarks",
        "downloads"
    ],
    
    "host_permissions": [
        "https://*.unsplash.com/*",
        "https://*.unsplash.it/*",
        "https://*.wallhaven.cc/*",
        "https://*.staticflickr.com/*",
        "https://*.desktopprassets.com/*",
        "https://*.visualhunt.com/*",
        "https://*.500px.org/*",
        "https://*.vo.msecnd.net/*",
        "https://*.nasa.gov/*",
        "https://*.flickr.com/*",
        "https://*.myqcloud.com/*",
        "https://*.ax1x.com/*",
        "https://*.loli.net/*",
        "https://*.nanxiongnandi.com/*",
        "https://*.vercel.app/*",
        "https://*.now.sh/*",
        "https://*.bing.com/*",
        "https://*.jsdelivr.net/*",
        "https://*.unpkg.com/*",
        "https://*.cdnjs.cloudflare.com/*",
        "https://*.googleusercontent.com/*",
        "https://*.imgur.com/*",
        "https://*.pexels.com/*",
        "https://*.pixabay.com/*",
        "https://*.yakei-kabegami.com/*"
    ],
    
    "omnibox": { 
        "keyword": "st" 
    },
    
    "commands": {
        "download": { 
            "suggested_key": { "default": "Alt+Shift+1" }, 
            "description": "__MSG_controlbar_download__" 
        },
        "favorite": { 
            "suggested_key": { "default": "Alt+Shift+2" }, 
            "description": "__MSG_controlbar_favorite__" 
        },
        "info": { 
            "suggested_key": { "default": "Alt+Shift+3" }, 
            "description": "__MSG_controlbar_info__" 
        },
        "upload": { 
            "suggested_key": { "default": "Alt+Shift+4" }, 
            "description": "__MSG_controlbar_upload__" 
        }
    }
}